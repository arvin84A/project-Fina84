body { font-family: Tahoma, Arial, sans-serif; margin: 0; background-color: #fcfcfc; color: #333; line-height: 1.6; }
header { background-color: #2c3e50; color: #ecf0f1; padding: 20px; text-align: center; }
nav a { color: #bdc3c7; text-decoration: none; margin: 0 15px; font-weight: bold; }
nav a:hover { color: #fff; }
main { padding: 40px; text-align: center; }
section { margin-bottom: 40px; border-bottom: 1px solid #ddd; padding-bottom: 20px; }
footer { background-color: #2c3e50; color: #bdc3c7; text-align: center; padding: 10px; position: fixed; bottom: 0; width: 100%; }
